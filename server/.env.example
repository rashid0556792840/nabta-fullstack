# Copy this file to ".env" and fill in real values. Never commit .env to Git.

# Port the API listens on (Render sets PORT automatically)
PORT=5000
NODE_ENV=development

# MongoDB connection string
#   Local:  mongodb://127.0.0.1:27017/nabta
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nabta?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nabta

# Secret used to sign login tokens (use a long random value, at least 32 characters)
JWT_SECRET=change_this_to_a_long_random_secret_value_123456
JWT_EXPIRES_IN=8h

# Frontend address(es) allowed to call the API (comma-separated)
CLIENT_URL=http://localhost:5173,http://localhost:8080

# Administrator account created automatically on first start (password: 10+ characters)
ADMIN_NAME=Nabta Admin
ADMIN_EMAIL=admin@nabta.local
ADMIN_PASSWORD=AdminPass123!

# Email (SMTP). Leave SMTP_HOST empty to save emails as files in server/logs/emails instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nabta Store <no-reply@nabta.local>"
# Where contact-form messages and daily reports are sent
STORE_EMAIL=admin@nabta.local
