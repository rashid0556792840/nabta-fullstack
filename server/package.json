{
  "name": "nabta-server",
  "version": "1.0.0",
  "description": "Nabta spice store - REST API (Node.js, Express, MongoDB)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "debug": "node --inspect src/server.js",
    "seed": "node scripts/seed.js",
    "email:test": "node scripts/send-test-email.js",
    "report:daily": "node scripts/daily-report.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.2.1"
  }
}
